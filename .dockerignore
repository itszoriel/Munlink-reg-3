# Keep the API image slim and avoid copying local artifacts
.git
node_modules
.turbo
.cp-images
uploads
tmp-tests
venv
apps/api/venv
# Built frontend bundles (rebuilt inside the image) - never ship local copies
dist
apps/web/dist
apps/admin/dist
# Stripe CLI is a local dev tool - not needed in the built site/image
public/payment/stripe-cli-1.35.0
apps/web/dist/payment
apps/admin/dist/payment
.pytest_cache
__pycache__
*.pyc
*.pyo
*.pyd
*.swp
*.log
*.sqlite

# Exclude local .env files - Railway will provide these via environment variables
.env
.env.*
apps/web/.env
apps/admin/.env
